+                    torch.Tensor.data_ptr, "data_ptr", sig[0], kind
+                )
+                add_guard(pointer.add_equals_match_guard, sig[0])
+            if root.check(guard_inputs):
+                self._binding_guard = root
+                self._binding_guard_inputs = guard_inputs
+        except (AttributeError, ImportError, TypeError, RuntimeError):
+            self._binding_guard = None
+            self._binding_guard_inputs = ()
