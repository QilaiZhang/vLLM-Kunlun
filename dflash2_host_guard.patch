+    def _build_binding_guard(self):
+        # Check the live mappings and tensor addresses in one host guard tree.
+        # TensorGuards alone permits storage replacement. Retain strong refs
+        # and validate every replay; this does not compile or run device ops.
+        if self._parameter_guard is None:
+            return
+        try:
+            from torch._dynamo.guards import GuardManagerType
+
+            def add_guard(method, value):
+                try:
+                    method(value, [])  # PyTorch 2.9.
+                except TypeError:
+                    method(value, [], None)  # Newer user_stack argument.
+
+            kind = GuardManagerType.GUARD_MANAGER
+            root = torch._C._dynamo.guards.RootGuardManager()
+            modules = tuple(binding[0] for binding in self._parameter_bindings)
+            guard_inputs = (modules, self._parameter_tensors)
+            module_guard = root.tuple_getitem_manager(0, "modules", modules, kind)
+            for index, module in enumerate(modules):
+                guard = module_guard.tuple_getitem_manager(
+                    index, str(index), module, kind
+                )
+                for name in ("_modules", "_parameters"):
+                    mapping = getattr(module, name)
+                    child = guard.getattr_manager(name, name, mapping, kind)
+                    add_guard(child.add_id_match_guard, id(mapping))
+                    add_guard(child.add_dict_version_guard, mapping)
+            parameters = root.tuple_getitem_manager(
